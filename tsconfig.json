{
    "compilerOptions": {
        "target":           "es2022",
        "module":           "esnext",
        "moduleResolution": "bundler",
        "allowJs":          true,
        "checkJs":          true,
        "noEmit":           true,
        "strict":           true,
        "esModuleInterop":  true,
        "skipLibCheck":     true,
        "paths": {
            "/js/*":         ["./public/js/*"],
            "/sections/*":   ["./src/Sections/*"],
            "/shell/*":      ["./src/Shell/*"],
            "/typography/*": ["./src/Typography/*"]
        }
    },
    "include": [
        "public/js/**/*.js",
        "src/Sections/**/Admin/*.js",
        "src/Shell/**/Admin/*.js",
        "src/Typography/**/Admin/*.js",
        "tests/js/**/*.js"
    ]
}
