# Copy to .env and edit. Same file is used for dev and prod (different
# values per environment). See notes/deploy.md for production setup.

APP_ENV=development
APP_DEBUG=true

# PHP-side DB credentials (read by PdoFactory)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=the_saiged
DB_USER=the_saiged
DB_PASS=dev

# MySQL container credentials (read by docker-compose.prod.yml).
# DB_PASS above must match MYSQL_PASSWORD.
MYSQL_PASSWORD=dev
MYSQL_ROOT_PASSWORD=dev

# Absolute path to the htpasswd file for nginx basic auth (production only).
HTPASSWD_PATH=/home/admin/the-saiged/.htpasswd

# Google OAuth2 ("Login with Google" admin auth) — create credentials at
# https://console.cloud.google.com/apis/credentials, authorized redirect
# URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# Email auto-inserted into `admins` with role=admin the first time it
# logs in via Google, but only while the admins table is still empty.
INITIAL_ADMIN_EMAIL=

# Google Analytics measurement id (e.g. G-XXXXXXXXXX). Leave empty to emit
# no GA script at all — used to keep local/dev traffic out of real GA.
GA_MEASUREMENT_ID=
